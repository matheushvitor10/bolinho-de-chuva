<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Back-end do Bolinho de Chuva (API).
    Não usa nenhum pacote NuGet externo (nem para enviar email): tudo aqui vem do próprio .NET 8,
    então é só rodar "npm start" na pasta principal.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!--
      Roda em qualquer .NET a partir do 8 (inclusive o 9 e o 10), se o 8 não
      estiver instalado no computador.
    -->
    <RollForward>Major</RollForward>
    <!--
      Roda com o mesmo "dotnet" que compilou o projeto. Assim não dá conflito
      entre .NET de 32 bits (x86) e de 64 bits (x64) no Windows.
    -->
    <UseAppHost>false</UseAppHost>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BolinhoDeChuva.Api</RootNamespace>
  </PropertyGroup>

  <!--
    Pasta Recursos: arquivos que ficam "embutidos" dentro do programa.
    - imagens do Bolin que vão dentro dos emails;
    - script-google.js, o código que a página de configuração entrega pronto pra colar no Google.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Recursos\bolin-email.jpg" LogicalName="bolin-email.jpg" />
    <EmbeddedResource Include="Recursos\bolin-avatar.png" LogicalName="bolin-avatar.png" />
    <EmbeddedResource Include="Recursos\bolin-alerta.png" LogicalName="bolin-alerta.png" />
    <EmbeddedResource Include="Recursos\script-google.js" LogicalName="script-google.js" />
    <Content Remove="Recursos\**" />
    <None Remove="Recursos\**" />
  </ItemGroup>

  <!-- Arquivos gerados enquanto a API roda: não fazem parte do código. -->
  <ItemGroup>
    <Content Remove="dados\**" />
    <Content Remove="emails-de-teste\**" />
    <None Remove="emails-de-teste\**" />
  </ItemGroup>

</Project>
