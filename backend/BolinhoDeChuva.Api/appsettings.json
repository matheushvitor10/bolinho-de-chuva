{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "OrigensPermitidas": [
      "http://localhost:5500",
      "http://127.0.0.1:5500"
    ]
  },

  "Sensor": {
    "Chave": "",
    "SegundosSemSinal": 60
  },

  // Botões de simulação da aba "Sensor" (para apresentar sem o hardware).
  "Simulacao": {
    "Habilitada": true
  },

  // Endereços usados nos links dos emails (botão "ver o site" e "cancelar inscrição").
  // Quando publicar, troque pelos endereços públicos.
  "Site": {
    "Url": "http://localhost:5500",
    "UrlApi": "http://localhost:5080"
  },

  // Gmail que envia os emails do sistema (boas-vindas e alertas).
  // A SENHA não fica aqui: fica no appsettings.Local.json (veja o README).
  "Email": {
    "Usuario": "bolinhodechuva2026@gmail.com",
    "Servidor": "smtp.gmail.com",
    "Porta": 587,
    "NomeRemetente": "Bolin — Bolinho de Chuva"
  },

  "Alertas": {
    "ChuvaForteMm": 30,
    "ChanceMinimaDeTrovoada": 60,
    "MinutosEntreAlertasDaMesmaZona": 30,
    // Email de "começou a chover": a partir de quantos mm na última hora conta
    // como chuva (chuva, pancadas e trovoada sempre contam; garoa fraca não),
    // e de quanto em quanto tempo, no máximo.
    "ChuvaMinimaMm": 0.5,
    "HorasEntreAlertasDeChuva": 6,
    "MinutosEntreChecagensDoClima": 10
  },

  // De onde vem o clima. Não precisa mexer (serve para testes).
  "Clima": {
    "UrlBase": "https://api.open-meteo.com",
    "MinutosDeCache": 5
  }
}
